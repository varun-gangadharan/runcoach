# Copy to .env.local and fill in. .env.local is gitignored.
# As in Runman, nothing here has a default in code — a missing value throws by
# name rather than falling back to something baked in.

# The same Supabase project Runman writes to. RunCoach only ever reads.
# The service-role key bypasses RLS, so it is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local stdio use only (Claude Desktop on your own machine) ---------------
# The deployed HTTP endpoint authenticates every request against the database,
# so neither of these is used in production.

# An API key issued from the Runman profile page. Preferred: exercises the same
# lookup the deployment does.
RUNCOACH_API_KEY=

# Or, for quick local iteration, the Strava athlete id directly.
RUNCOACH_ATHLETE_ID=
